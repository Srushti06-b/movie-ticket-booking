<?xml version="1.0" encoding="utf-8"?>
<!-- Legends Of Dawn - animated fantasy poster -->
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="800" viewBox="0 0 600 800">
  <defs>
    <linearGradient id="g7" x1="0" x2="1">
      <stop offset="0%" stop-color="#07121a"/>
      <stop offset="100%" stop-color="#0b1a2a"/>
    </linearGradient>
    <filter id="glow"><feGaussianBlur stdDeviation="12" result="b"/></filter>
    <style>
      .title { font: 700 40px "Poppins", Arial, sans-serif; fill:#fffdf6; }
      .accent { fill:#cdb4db; font: 14px "Poppins", Arial, sans-serif; }
    </style>
  </defs>

  <rect width="600" height="800" fill="url(#g7)"/>

  <!-- floating lights -->
  <g filter="url(#glow)" opacity="0.7" fill="#cdb4db">
    <circle cx="140" cy="200" r="8"><animate attributeName="cy" values="200;180;200" dur="6s" repeatCount="indefinite"/></circle>
    <circle cx="420" cy="180" r="10"><animate attributeName="cy" values="180;200;180" dur="7s" repeatCount="indefinite"/></circle>
    <circle cx="320" cy="360" r="6"><animate attributeName="cy" values="360;340;360" dur="5s" repeatCount="indefinite"/></circle>
  </g>

  <!-- sword & crest silhouette with slow rotation -->
  <g transform="translate(300,400)">
    <path d="M-20 -180 L20 -180 L40 -40 L0 -10 L-40 -40 z" fill="#f6f2ff" opacity="0.06"/>
    <rect x="-6" y="-40" width="12" height="240" rx="6" fill="#e9d9ff" opacity="0.08"/>
    <g transform="translate(0,40)">
      <path d="M-60 80 C -30 40 30 40 60 80 C 30 20 -30 20 -60 80 z" fill="#fffbf9" opacity="0.04"/>
    </g>
    <animateTransform attributeName="transform" type="rotate" values="0;2;0;-2;0" dur="12s" repeatCount="indefinite"/>
  </g>

  <!-- title -->
  <text x="48" y="118" class="title">LEGENDS</text>
  <text x="48" y="160" class="title">OF DAWN</text>

  <text x="48" y="220" class="accent">A sweeping fantasy of magic & destiny</text>

  <!-- poster card -->
  <rect x="36" y="220" width="528" height="420" rx="12" fill="#07121a" stroke="#ffffff" stroke-opacity="0.02"/>

  <!-- details block -->
  <g transform="translate(48,300)" fill="#e8dfef">
    <text x="0" y="40" font-size="14">Fantasy • 2h 20m • ⭐ 8.3</text>
    <text x="0" y="68" font-size="14">Release: 2026-04-05</text>
    <text x="0" y="96" font-size="14">Language: Telugu</text>
  </g>

  <!-- shimmering rune symbols -->
  <g transform="translate(480,360)" fill="#cdb4db" opacity="0.85">
    <text x="-18" y="0" font-size="28">✦</text>
    <text x="-12" y="36" font-size="18">✶</text>
    <animateTransform attributeName="transform" type="translate" values="480,360;470,350;480,360" dur="6s" repeatCount="indefinite"/>
  </g>
</svg>
